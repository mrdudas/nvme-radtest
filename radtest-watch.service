[Unit]
Description=radtest NVMe hot-plug watcher (post-irradiation testing)
After=local-fs.target
ConditionPathExists=/root/nvme-radtest/bin/nvblk

[Service]
Type=simple
WorkingDirectory=/root/nvme-radtest
# Manual mode: a test only starts when someone presses Start in the web UI
# (or runs "radtest.py start <ctrl>"). Add --auto to test every inserted drive
# immediately, without asking.
ExecStart=/usr/bin/python3 /root/nvme-radtest/radtest.py watch
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=300
StandardOutput=append:/root/nvme-radtest/results_watch.out
StandardError=append:/root/nvme-radtest/results_watch.out

[Install]
WantedBy=multi-user.target
